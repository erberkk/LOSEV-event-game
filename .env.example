# QR afişlerine basılacak kalıcı alan adı (ör. https://izinde.losev.org.tr).
# Boş bırakılırsa sayfanın açıldığı adres kullanılır.
VITE_PUBLIC_URL=


# Vektör harita karoları (opsiyonel). Boşsa OpenFreeMap kullanılır (ücretsiz, anahtarsız).
# Etkinlik trafiği için kendi karo sunucusu ya da MapTiler gibi bir sağlayıcının TileJSON adresi verilebilir.
VITE_MAP_TILES=

# Katılımcı kayıtlarının yazılacağı Google Apps Script Web App adresi (apps-script/KURULUM.md).
# Boşsa kayıtlar sadece oyuncunun cihazında kalır.
VITE_SHEET_ENDPOINT=
